# Holly Core — local only by default
PORT=4000
HOST=127.0.0.1
OWNER_PIN=0000
# Session lifetime (ms), default 12h
SESSION_TTL_MS=43200000
# Comma-separated workspace roots the agent may touch
WORKSPACE_ROOTS=/home/jamajka666/Holly-2.0
# Set true only on trusted LAN (never public internet)
ALLOW_LAN=false
# Local LLM (optional — without it agent uses heuristic mode)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Kali VM bridge (SSH profiles only — never free shell)
# KALI_ENABLED=true
# KALI_SSH_HOST=192.168.122.50
# KALI_SSH_PORT=22
# KALI_SSH_USER=kali
# KALI_SSH_KEY=~/.ssh/holly_kali_ed25519
# KALI_SSH_STRICT_HOSTKEY=accept-new
# KALI_SSH_CONNECT_TIMEOUT=5
# KALI_SSH_COMMAND_TIMEOUT_MS=60000

