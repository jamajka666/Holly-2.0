# Holly Core — local only by default
PORT=4000
HOST=127.0.0.1
OWNER_PIN=0000
# Comma-separated workspace roots the agent may touch
WORKSPACE_ROOTS=/home/jamajka666/Holly-2.0
# Set true only on trusted LAN (never public internet)
ALLOW_LAN=false
# Local LLM (optional — without it agent uses heuristic mode)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
